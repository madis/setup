" Keybindings for LSP functionality
augroup lsp_keymaps
  autocmd!
  autocmd LspAttach * nnoremap <silent> gd :lua vim.lsp.buf.definition()<CR>
  autocmd LspAttach * nnoremap <silent> KK :lua vim.lsp.buf.hover()<CR>
  autocmd LspAttach * nnoremap <silent> grn :lua vim.lsp.buf.rename()<CR>
  autocmd LspAttach * nnoremap <silent> grr :lua vim.lsp.buf.references()<CR>
  autocmd LspAttach * nnoremap <silent> gra :lua vim.lsp.buf.code_action()<CR>
  autocmd LspAttach * inoremap <silent> <C-s> <cmd>lua vim.lsp.buf.signature_help()<CR>
augroup END


set nocompatible " Enable vim's enhanced features (in comparation with vi)
filetype plugin indent on " Enable automatic filetype detection & plugins for it
syntax enable " Enable syntax highlighting


set listchars=tab:>\ ,trail:•,extends:>,precedes:<,nbsp:+
set list

let mapleader = ","

set expandtab " insert spaces instead of TAB when clicking TAB key
set tabstop=2 " tab size = 2 spaces
set shiftwidth=2 " indentation size (when using << or >>)

set autoindent " indents a new line to match the indentation of the previous line
set backspace=indent,eol,start " allow normal use of BACKSPACE character
set ignorecase " searches case-insensitive by default
set smartcase " overrides ignorecase for searches with uppercase letters
set number " show line numbers on the left
set ttimeout " Enables timeout for terminal key sequences, allowing Vim to distinguish between single keypresses and multi-key sequences (e.g., mappings)
set ttimeoutlen=100 " If a key sequence isn’t completed within this time, Vim processes the input as individual keys
set title " set the terminal window’s title to reflect the current file or buffer
set titlestring=%t " set the terminal title to the filename of the current buffer
set incsearch " Enables incremental search, where Vim highlights matches as you type the search term, updating in real-time with each keystroke

" Use F3 to clear search highlighting
nnoremap <F3> :set hlsearch!<CR>
" Use F2 to remove search highlighting
nnoremap <F2> :noh<return>


" Shortcut to open current file in new tab
nnoremap <leader>tt :tabnew %<cr>
au TabLeave * let g:lasttab = tabpagenr()
" Return to last tab - tr - tab return
nnoremap <silent> <leader>tr :exe "tabn ".g:lasttab<cr>
vnoremap <silent> <leader>tr :exe "tabn ".g:lasttab<cr>
" Go to tab by number
noremap <M-1> 1gt
noremap <M-2> 2gt
noremap <M-3> 3gt
noremap <M-4> 4gt
noremap <M-5> 5gt
noremap <M-6> 6gt

call plug#begin('~/.vim/plugged')

Plug 'christoomey/vim-tmux-navigator'
Plug 'christoomey/vim-tmux-runner'
Plug 'tpope/vim-obsession'
Plug 'tpope/vim-surround'
Plug 'tpope/vim-fugitive'
Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
Plug 'junegunn/fzf.vim'
Plug 'jiangmiao/auto-pairs'

Plug 'neoclide/coc.nvim', {'branch': 'release'}  " For LSP integration and autocompletion
Plug 'nvim-treesitter/nvim-treesitter', {'do': ':TSUpdate'}  " For better syntax highlighting
Plug 'morhetz/gruvbox'  " Optional: theme for better visibility

Plug 'vim-airline/vim-airline'
Plug 'vim-airline/vim-airline-themes'
Plug 'airblade/vim-gitgutter'

call plug#end()

let g:gruvbox_italic=1
colorscheme gruvbox
let g:airline_theme='gruvbox'

" Make fzf respect .gitignore by making it to use RipGrep
let $FZF_DEFAULT_COMMAND = 'rg --files --hidden --follow --glob "!.git/*"'

" fzf.vim dialog
nnoremap <leader>o :Files<cr>
" Map backslash for searching with Ag
nnoremap <leader>f :Rg<cr>

" START Coc configuration
" Coc.nvim configuration
let g:coc_global_extensions = ['coc-clojure', 'coc-json', 'coc-tsserver']

" Use <Tab> for completion
set signcolumn=yes
inoremap <silent><expr> <TAB>
      \ pumvisible() ? "\<C-n>" :
      \ <SID>check_back_space() ? "\<TAB>" :
      \ coc#refresh()
inoremap <expr><S-TAB> pumvisible() ? "\<C-p>" : "\<C-h>"

function! s:check_back_space() abort
  let col = col('.') - 1
  return !col || getline('.')[col - 1] =~# '\s'
endfunction

" Code navigation keybindings
nmap <silent> gd <Plug>(coc-definition)  " Go to definition
nmap <silent> gy <Plug>(coc-type-definition)  " Go to type definition
nmap <silent> gi <Plug>(coc-implementation)  " Go to implementation
nmap <silent> gr <Plug>(coc-references)  " Find references

" END Coc configuration

" treesitter config in Lua from ~/.config/nvim/lua/config/treesitter.lua
lua require('config/treesitter') 

" vim-airline Enable tabline
let g:airline#extensions#tabline#enabled = 1

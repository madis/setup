set nocompatible " Enable vim's enhanced features (in comparation with vi)
filetype plugin indent on " Enable automatic filetype detection & plugins for it
syntax enable " Enable syntax highlighting


set listchars=tab:>\ ,trail:•,extends:>,precedes:<,nbsp:+
set list

let mapleader = ","
let maplocalleader = "\\"

set expandtab " insert spaces instead of TAB when clicking TAB key
set tabstop=2 " tab size = 2 spaces
set shiftwidth=2 " indentation size (when using << or >>)
set termguicolors " for better colors

set autoindent " indents a new line to match the indentation of the previous line
set backspace=indent,eol,start " allow normal use of BACKSPACE character
set ignorecase " searches case-insensitive by default
set smartcase " overrides ignorecase for searches with uppercase letters
set number " show line numbers on the left
set ttimeout " Enables timeout for terminal key sequences, allowing Vim to distinguish between single keypresses and multi-key sequences (e.g., mappings)
set ttimeoutlen=100 " If a key sequence isn’t completed within this time, Vim processes the input as individual keys
set title " set the terminal window’s title to reflect the current file or buffer
set titlestring=%t " set the terminal title to the filename of the current buffer
set incsearch " Enables incremental search, where Vim highlights matches as you type the search term, updating in real-time with each keystroke
set splitright " Open new splits to right instead of left (reading order, more logical)
set splitbelow " Open new splits to bottom instead of up (more logical, reading order)
set cursorline " Have cursor row highlighted
"set exrc " Enable running project-local configuration

" Use F3 to clear search highlighting
nnoremap <F3> :set hlsearch!<CR>
" Use F2 to remove search highlighting
nnoremap <F2> :noh<return>


" Shortcut to open current file in new tab
nnoremap <leader>tt :tabnew %<cr>
au TabLeave * let g:lasttab = tabpagenr()
" Return to last tab - tr - tab return
nnoremap <silent> <leader>tr :exe "tabn ".g:lasttab<cr>
vnoremap <silent> <leader>tr :exe "tabn ".g:lasttab<cr>
" Go to tab by number
noremap <M-1> 1gt
noremap <M-2> 2gt
noremap <M-3> 3gt
noremap <M-4> 4gt
noremap <M-5> 5gt
noremap <M-6> 6gt

autocmd FileType clojure,markdown autocmd BufWritePre <buffer> :%s/\s\+$//e " Remove trailing whitespaces on save
